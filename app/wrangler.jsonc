// Cloudflare Workers settings for Chairvana (built with OpenNext).
// Variables and secrets are set in the Cloudflare dashboard, not here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon",
  "main": ".open-next/worker.js",
  // Keep variables set in the dashboard (SUPABASE_URL, OWNER_EMAILS, ...) across deploys.
  "keep_vars": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "salon"
    }
  ],
  "observability": {
    "enabled": true
  }
}
