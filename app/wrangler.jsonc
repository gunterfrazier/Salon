// Cloudflare Workers settings for Chairvana (built with OpenNext).
// Variables and secrets are set in the Cloudflare dashboard, not here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "salon",
  "main": "worker.ts",
  // Keep variables set in the dashboard (SUPABASE_URL, OWNER_EMAILS, ...) across deploys.
  "keep_vars": true,
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "salon"
    }
  ],
  // Email through Cloudflare Email Service (sending domain mail.chairvana.app).
  "send_email": [{ "name": "EMAIL" }],
  // Every 5 minutes: reminders, unpaid deposit holds, day preview (worker.ts → /api/cron/messages).
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
